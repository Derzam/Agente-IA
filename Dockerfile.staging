FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci
COPY apps/api apps/api
COPY packages/shared packages/shared
RUN npm run api:build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0
ENV NODE_EXTRA_CA_CERTS=/app/config/certs/supabase-root-2021.crt
COPY --from=build --chown=node:node /app /app
COPY --chown=node:node config/certs/supabase-root-2021.crt /app/config/certs/supabase-root-2021.crt
USER node
EXPOSE 3000 3001
CMD ["npm","run","api:start"]
# Use the same image with ["npm","run","worker:start"] as the separate worker command.
# HTTPS, secrets, restart policy and deployment target must be authorized externally.
