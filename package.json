{
  "name": "agente-ia",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run dev --workspace=@agente-ia/api",
    "api:build": "npm run build --workspace=@agente-ia/api",
    "api:start": "npm run start --workspace=@agente-ia/api",
    "api:test": "npm run test --workspace=@agente-ia/api",
    "worker:dev": "npm run worker:dev --workspace=@agente-ia/api",
    "worker:start": "npm run worker:start --workspace=@agente-ia/api",
    "admin:dev": "npm run dev --workspace=@agente-ia/admin",
    "admin:build": "npm run build --workspace=@agente-ia/admin",
    "admin:test": "npm run test --workspace=@agente-ia/admin",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
