{
  "name": "@agente-ia/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/bootstrap/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/bootstrap/main.js",
    "worker:dev": "node --env-file-if-exists=../../.env --import tsx src/bootstrap/worker.ts",
    "worker:start": "node --env-file-if-exists=../../.env dist/bootstrap/worker.js",
    "test": "node ../../scripts/run-api-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agente-ia/shared": "0.1.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "openai": "7.27.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
