# Copy to .env locally. Never commit real credentials.
# Deployment injects separate secret sets per process. Do not share this entire
# file between API and worker: API owns DATABASE_URL/WEBHOOK_DATABASE_URL,
# META_APP_SECRET/META_VERIFY_TOKEN and CURSOR_HMAC_*; worker owns
# WORKER_DATABASE_URL, OPENAI_*, Meta outbound credentials and CONFIRMATION_*.
# RUNTIME_ENV/SUPABASE_URL are non-secret scope checks shared by both processes.
NODE_ENV=development
PORT=3000

# WhatsApp Cloud API (leave blank until configured)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Explicit Graph API version; decide and verify in sandbox in phase 2
WHATSAPP_API_VERSION=

# OpenAI (leave blank until configured)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_MAX_TOOL_CALLS=
OPENAI_TIMEOUT_MS=
# Bounded retries (default 1, at most 2) and Responses per turn (default 9, at most 33).
OPENAI_MAX_RETRIES=
OPENAI_MAX_RESPONSES=

# Global runtime flags are independent of business_settings.ai_enabled. Empty = false.
AI_RUNTIME_ENABLED=
META_OUTBOUND_ENABLED=
RUNTIME_ENV=
# META_* is canonical; WHATSAPP_* above remains inbound compatibility only.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
META_TIMEOUT_MS=
# Explicit sandbox-only allowlist, secret-managed; digits, comma separated.
META_SANDBOX_RECIPIENTS=
# 32 random bytes as 64 hex characters. API instances share this secret.
CURSOR_HMAC_KEY=
# Temporary previous key for cursor rotation; remove after bounded overlap.
CURSOR_HMAC_PREVIOUS_KEY=
# Secret-managed JSON key-version -> 64-hex AES-256 key. No real values here.
CONFIRMATION_TRANSPORT_KEYS=
CONFIRMATION_ACTIVE_KEY_VERSION=
# Fixed budget windows (seconds), tenant and conversation caps, no monetary model pricing.
AI_BUDGET_WINDOW_SECONDS=
AI_TENANT_INPUT_TOKENS=
AI_TENANT_OUTPUT_TOKENS=
AI_TENANT_RESPONSES=
AI_TENANT_TOOLS=
AI_CONVERSATION_INPUT_TOKENS=
AI_CONVERSATION_OUTPUT_TOKENS=
AI_CONVERSATION_RESPONSES=
AI_CONVERSATION_TOOLS=
HOST=
WORKER_HEALTH_PORT=

# Supabase (leave blank until configured)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Restricted administrative credential. NOT used by operational API/ingress.
SUPABASE_SERVICE_ROLE_KEY=
# Prefer publishable key for future admin Auth; legacy anon above retained
SUPABASE_PUBLISHABLE_KEY=
# Restricted runtime DB role (not migration owner, not service_role)
DATABASE_URL=
# Separate restricted ingress LOGIN principal; grant only app_ingress (never app_api)
WEBHOOK_DATABASE_URL=
# Separate restricted worker LOGIN principal; grant only app_worker.
WORKER_DATABASE_URL=
# Comma-separated exact HTTPS image hostnames; empty rejects non-null product images.
PRODUCT_IMAGE_ALLOWED_HOSTS=
# Comma-separated explicit admin origins; configure in phase 2
ADMIN_ALLOWED_ORIGINS=

# Admin frontend (non-secret)
# true keeps the UI on local demo data; false enables Supabase Auth + API adapters.
VITE_USE_MOCK_DATA=
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy/mock-only fallback. Real mode selects businesses from GET /v1/me.
VITE_BUSINESS_ID=
