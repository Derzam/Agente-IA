# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=3000

# WhatsApp Cloud API (leave blank until configured)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# OpenAI (leave blank until configured)
OPENAI_API_KEY=

# Supabase (leave blank until configured)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
